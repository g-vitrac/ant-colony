{% extends 'base.html.twig' %}


{% block body %}
    <main>
        <canvas id="c"></canvas>
        <div id="options">
            <button id="hide-btn" type="button">
                hide
            </button>
            <div id="options-container">
                <label>
                    fps :
                    <output id="fps">0</output>
                </label>
                <label>
                    smoke :
                    <input id="smoke-cb" type="checkbox" checked>s
                </label>
                <label>
                    debug :
                    <input id="engine-debug" type="checkbox">
                </label>
                <label>
                    nb ants :
                    <input id="ant-number" type="range" value="25000" min="1" max ="70000" oninput="this.nextElementSibling.value = this.value">
                    <output></output>
                </label>
                <label>
                    nb frame to test :
                    <input id="frame-to-test" type="number" value="1" min="1" step="1" >
                </label>
            </div>
        </div>
    </main>
{% endblock %}
